# Base de datos
DB_HOST=postgres
DB_PORT=5432
DB_USER=tienda_user
DB_PASSWORD=tienda_pass
DB_NAME=tienda_db

# App
PORT=3001
NODE_ENV=development

# Auth (panel admin)
JWT_SECRET=cambia_esto_por_un_valor_seguro
JWT_EXPIRES_IN=7d

# WhatsApp de la tienda (formato internacional, sin +)
STORE_WHATSAPP_NUMBER=18298253309

# Panel administrativo — se crea automáticamente con estas credenciales al arrancar el backend
ADMIN_EMAIL=admin@mitienda.com
ADMIN_PASSWORD=cambia_esta_clave

# URL del frontend, usada para armar el link de "olvidé mi contraseña"
FRONTEND_URL=http://localhost:3000

# Correo saliente (opcional). Si se deja vacío, el link de recuperación de contraseña
# se muestra en la consola del backend en vez de enviarse por correo real.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Mi Marca <no-reply@mitienda.com>
